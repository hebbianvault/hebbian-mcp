{
  "name": "@hebbianvault/mcp",
  "version": "0.4.2",
  "description": "Customer-installable MCP server for the Hebbian tenant brain. One package, scope-by-token (Employee or Company). Install in Claude Code, Claude Desktop, Cursor, Cowork, or any MCP-compatible agent.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "hebbian-mcp": "dist/index.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hebbianvault/hebbian-mcp.git"
  },
  "homepage": "https://github.com/hebbianvault/hebbian-mcp#readme",
  "bugs": {
    "url": "https://github.com/hebbianvault/hebbian-mcp/issues"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsc && node -e \"const{mkdirSync,cpSync}=require('fs');mkdirSync('dist/assets',{recursive:true});cpSync('src/assets/lockup.txt','dist/assets/lockup.txt')\"",
    "dev": "tsc --watch",
    "test": "node --experimental-vm-modules node_modules/.bin/jest --config=jest.config.cjs tests/",
    "prepublishOnly": "npm run build && npm test",
    "start": "node dist/index.js",
    "postinstall": "node scripts/postinstall.mjs || true"
  },
  "keywords": [
    "mcp",
    "hebbian",
    "knowledge-graph",
    "ai-tools",
    "model-context-protocol"
  ],
  "author": "Hebbian",
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^22.0.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.9",
    "typescript": "^5.6.3"
  }
}
